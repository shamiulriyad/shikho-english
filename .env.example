# =====================================================================================
#  Shikho English: the ONE settings file for the whole project
# =====================================================================================
# Copy this file to ".env" in the same folder (the repository root) and fill it in.
#   - Backend, database tools (dotnet ef, scripts/New-MigrationScript.ps1) and frontend all read it.
#   - Only VITE_* values are sent to the browser. Everything else stays on the server.
#   - .env is in .gitignore: never commit it, never paste it into chat.
#   - A real environment variable with the same name always wins over this file.
#   - On a server: copy a filled-in .env next to the app (protect it), set SHIKHO_ENV_FILE=<path>,
#     or set the same names as environment variables in the host's settings. See docs/DEPLOYMENT.md.
# "__" separates nested settings: Ai__Gemini__ApiKey is the setting Ai:Gemini:ApiKey.

# ---------- Environment ----------
# Development locally; Production on a server (stricter checks, no automatic migrations).
ASPNETCORE_ENVIRONMENT=Development

# ---------- Addresses (keep these four in sync) ----------
# Where the backend API listens
ASPNETCORE_URLS=http://localhost:5000
# Port of the frontend dev server (npm run dev / npm run preview)
FRONTEND_PORT=3000
# Frontend address(es) allowed to call the API; comma separated
Cors__AllowedOrigins=http://localhost:3000
# API address the frontend calls (public: compiled into the browser bundle)
VITE_API_BASE_URL=http://localhost:5000/api

# ---------- Database: Supabase ----------
# Everything the app needs to connect to Supabase. Fill these in and leave
# ConnectionStrings__DefaultConnection (below) empty; the backend builds the connection itself.
# Not needed: the Supabase URL, anon key and service_role key (only the backend talks to the database).
#
# Project ID: Supabase -> Project Settings -> General -> Project ID
SUPABASE_PROJECT_REF=
# Session pooler host (works over IPv4): Supabase -> Connect -> "Session pooler"
#   e.g. aws-0-ap-south-1.pooler.supabase.com  (host name only, not the postgresql:// link)
SUPABASE_POOLER_HOST=
# Database password: Supabase -> Project Settings -> Database (reset it there if you lost it)
SUPABASE_DB_PASSWORD=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
# Require: encrypted. VerifyFull: encrypted AND checks it really is Supabase (required on servers).
# For VerifyFull download Supabase -> Project Settings -> Database -> SSL Configuration -> Download certificate
# and save it as certs/supabase-ca.crt (certs/ is never committed).
SUPABASE_SSL_MODE=Require
SUPABASE_CA_CERT=certs/supabase-ca.crt

# ---------- Database: full connection string (optional) ----------
# If set, this wins over the SUPABASE_* settings. Use it for the local Docker database:
#   ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=learnEnglish_dev;Username=postgres;Password=<password>
ConnectionStrings__DefaultConnection=

# true: Development applies pending migrations to a LOCAL database at startup.
# Keep false for Supabase (it is only migrated with reviewed SQL: scripts/New-MigrationScript.ps1);
# the backend refuses to auto-migrate a remote database. Never allowed outside Development.
Database__MigrateOnStartup=false

# ---------- Login tokens ----------
# A random value of at least 32 bytes. PowerShell (cryptographically secure):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
Jwt__Secret=
Jwt__ExpiryMinutes=120

# ---------- AI ----------
# Gemini (default). Get a key at https://aistudio.google.com
Ai__Provider=Gemini
Ai__Gemini__ApiKey=
Ai__Gemini__Model=gemini-3.5-flash-lite
# OpenAI instead: set Ai__Provider=OpenAI and fill in
Ai__OpenAI__ApiKey=
Ai__OpenAI__Model=gpt-4o-mini

# ---------- Limits (per minute) ----------
# AI calls per student, and login/registration attempts per IP address
RateLimiting__AiRequestsPerMinute=20
RateLimiting__AuthRequestsPerMinute=30

{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "GrammarLearner",
    "Audience": "GrammarLearnerUsers",
    "ExpiryMinutes": 60
  },
  "Ai": {
    "Provider": "Gemini",
    "TimeoutSeconds": 30,
    "Gemini": {
      "ApiKey": "",
      "Model": "gemini-3.5-flash-lite",
      "MaxOutputTokens": 2048
    },
    "OpenAI": {
      "ApiKey": "",
      "Model": "gpt-4o-mini",
      "MaxOutputTokens": 1000
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimiting": {
    "AiRequestsPerMinute": 20,
    "AuthRequestsPerMinute": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:3000,http://localhost:5000"
  }
}

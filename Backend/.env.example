# Configuration for non-Development environments (staging, production).
# ASP.NET Core reads environment variables directly; "__" separates nested keys.
# Nothing loads this file automatically: set these variables on your host.
# For local development use `dotnet user-secrets` instead (see README).
# Never set Database__MigrateOnStartup outside Development; apply reviewed migration scripts instead.

ASPNETCORE_ENVIRONMENT=Production
# Remote databases must use SSL Mode=Require; see docs/DEPLOYMENT.md for Supabase
ConnectionStrings__DefaultConnection=Host=<host>;Port=5432;Database=<database>;Username=<user>;Password=<password>;SSL Mode=Require
Jwt__Secret=<random value, at least 32 bytes>
Jwt__Issuer=GrammarLearner
Jwt__Audience=GrammarLearnerUsers
Jwt__ExpiryMinutes=60
Ai__Provider=Gemini
Ai__Gemini__ApiKey=<your Gemini API key>
Ai__Gemini__Model=gemini-3.5-flash-lite
# Only needed when Ai__Provider=OpenAI
Ai__OpenAI__ApiKey=<your OpenAI API key>
Ai__OpenAI__Model=gpt-4o-mini
Cors__AllowedOrigins=https://<your-frontend-domain>
# Optional limits (per minute): AI calls per student, login/registration per IP address
RateLimiting__AiRequestsPerMinute=20
RateLimiting__AuthRequestsPerMinute=30
